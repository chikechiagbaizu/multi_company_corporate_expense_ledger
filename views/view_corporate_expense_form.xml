<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <data>
        <record id="view_corporate_expense_form" model="ir.ui.view">
            <field name="name">corporate_expense_form_view</field>
            <field name="model">corporate.expense</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_approve" string="Approve" type="object"
                            class="btn-primary" invisible="state != 'draft'" />
                        <button name="action_deny" string="Deny" type="object"
                            class="btn-secondary" invisible="state != 'draft'" />
                        <field name="state" widget="statusbar" />
                    </header>
                    <sheet>
                        <group>
                            <field name="name" />
                            <field name="amount" />
                            <field name="company_id" />
                            <field name="invoice_id" readonly="state != 'draft'" />
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>